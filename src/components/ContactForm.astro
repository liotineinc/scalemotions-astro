---
import FormLegalLinks from "./FormLegalLinks.astro";
import { auditQuestions, formShared, type EntryIntent } from "../data/home";

interface Props {
  intent?: EntryIntent;
  heading?: string;
  compact?: boolean;
  source?: string;
  variant?: string;
}

const {
  intent = "diagnostic",
  heading = "Start your free recovery check",
  compact = false,
  source = "website",
  variant,
} = Astro.props;

const question = auditQuestions[intent];
---

<form class:list={["audit-shell contact-form", compact && "audit-shell-hero"]} method="post" action="" name="free-feedback">
  <!-- Integration note: connect this form action to GoHighLevel, Formspree, Netlify Forms, or a Cloudflare Worker endpoint. Phone is intentionally omitted while SMS opt-in is handled by the LeadConnector chat widget. -->
  <input type="hidden" name="source" value={source} />
  {/* ASSUMPTION: the repo form had no form_variant hidden field and no webhook
      wired yet (action=""), so the spec's variant field is added here rather
      than blocking. Rendered only when a variant is passed, so /contact keeps
      its exact current submission shape. */}
  {variant && <input type="hidden" name="form_variant" value={variant} />}
  <div>
    <p class="micro label-eyebrow">{formShared.cardLabel}</p>
    <h2 class="heading-tight text-balance" style="font-size: clamp(1.8rem, 4vw, 3.1rem); margin-top: 0.45rem;">{heading}</h2>
    <p class="form-note" style="margin-top: 0.75rem;">
      {formShared.microcopy}
    </p>
  </div>

  <fieldset class="form-step">
    <legend class="micro">{question.question}</legend>
    <div class="choice-grid">
      {question.options.map((option) => (
        <label class="choice-option">
          <input type="radio" name="priority" value={option} required />
          <span>{option}</span>
        </label>
      ))}
    </div>
  </fieldset>

  <div class="form-step">
    <label class="micro" for={"website-" + source}>{formShared.fields.website.label}</label>
    {/* ASSUMPTION: type changed url -> text because the spec's placeholder invites
        a Google business name, which type="url" validation would reject and block
        GBP-only visitors from submitting. Field name unchanged. */}
    <input class="field" id={"website-" + source} name="website_or_profile" type="text" placeholder={formShared.fields.website.placeholder} required />
  </div>

  <div class="field-grid">
    <div class="form-step">
      <label class="micro" for={"industry-" + source}>{formShared.fields.industry.label}</label>
      <input class="field" id={"industry-" + source} name="industry" type="text" placeholder={formShared.fields.industry.placeholder} required />
    </div>
    <div class="form-step">
      <label class="micro" for={"market-" + source}>{formShared.fields.market.label}</label>
      <input class="field" id={"market-" + source} name="market" type="text" placeholder={formShared.fields.market.placeholder} required />
    </div>
  </div>

  <div class="field-grid">
    <div class="form-step">
      <label class="micro" for={"name-" + source}>{formShared.fields.name.label}</label>
      <input class="field" id={"name-" + source} name="name" type="text" autocomplete="name" required />
    </div>
    <div class="form-step">
      <label class="micro" for={"email-" + source}>{formShared.fields.email.label}</label>
      <input class="field" id={"email-" + source} name="email" type="email" autocomplete="email" required />
    </div>
  </div>

  {!compact && (
    <div class="form-step">
      <label class="micro" for={"challenge-" + source}>{formShared.fields.notes.label}</label>
      <textarea class="textarea" id={"challenge-" + source} name="challenge"></textarea>
    </div>
  )}

  <button class="primary-pill" type="submit">{formShared.submit}</button>
  <FormLegalLinks />
</form>
